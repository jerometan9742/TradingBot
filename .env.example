# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Financial Data APIs ───────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your-key-here
FINNHUB_API_KEY=your-key-here
FMP_API_KEY=your-key-here

# ── Brokerage ─────────────────────────────────────────────────
# Alpaca (paper trading to start)
ALPACA_API_KEY=your-key-here
ALPACA_SECRET_KEY=your-key-here
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # Switch to live when ready

# Tiger Brokers (optional, for SGX/HK markets)
TIGER_ACCOUNT_ID=your-account-id
TIGER_PRIVATE_KEY_PATH=./tiger_private_key.pem

# ── Notifications ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# ── Bot Configuration ─────────────────────────────────────────
# Watchlist: comma-separated tickers
WATCHLIST=AAPL,MSFT,GOOGL,NVDA,DBS.SI

# Risk parameters
MAX_POSITION_SIZE_PCT=0.05       # Max 5% of portfolio per position
MAX_DAILY_LOSS_PCT=0.02          # Kill switch at 2% daily loss
MIN_CONFIDENCE_SCORE=7           # Minimum score (1-10) to place a trade
MAX_TRADES_PER_DAY=5

# Analysis schedule (cron format)
ANALYSIS_SCHEDULE=0 9,15 * * 1-5  # 9am and 3pm SGT, weekdays

# Paper vs live trading
TRADING_MODE=paper               # Change to 'live' only after validation
