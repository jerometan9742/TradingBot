# AI Trading Bot — Price Monitor (SL/TP watcher)
#
# Runs monitoring/price_monitor.py continuously, restarting on crash.
# Polls open positions every 60s and fires market exits on SL/TP breach.
#
# SETUP (one-time, on the VPS):
#   1. Update WorkingDirectory and ExecStart paths if your project is not at /opt/ai-trading-bot
#   2. Update User to match the OS user that owns the project directory
#   3. sudo cp deploy/price_monitor.service /etc/systemd/system/
#   4. sudo systemctl daemon-reload
#   5. sudo systemctl enable price_monitor
#   6. sudo systemctl start price_monitor
#
# OPERATIONS:
#   sudo systemctl status price_monitor
#   sudo journalctl -u price_monitor -f          # live logs
#   sudo systemctl restart price_monitor
#   sudo systemctl stop price_monitor

[Unit]
Description=AI Trading Bot — Price Monitor (SL/TP watcher)
Documentation=https://github.com/jerometan9742/TradingBot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

WorkingDirectory=/opt/ai-trading-bot
ExecStart=/opt/ai-trading-bot/venv/bin/python monitoring/price_monitor.py

# Restart immediately on crash; give it 10s before retrying
Restart=always
RestartSec=10

# Log to journald (view with: journalctl -u price_monitor)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=price-monitor

# Load .env automatically via EnvironmentFile
EnvironmentFile=/opt/ai-trading-bot/.env

# Resource limits — price monitor is lightweight
MemoryMax=256M

[Install]
WantedBy=multi-user.target
